{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled dashboard may call mining and desktop commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-request",
    "allow-cancel-request",
    "allow-quit-app",
    "allow-restart-app",
    "allow-open-app-folder",
    "allow-desktop-settings",
    "allow-desktop-title",
    "allow-desktop-update",
    "allow-state-open",
    "allow-state-next",
    "allow-state-close"
  ]
}
